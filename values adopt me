local function makeValueIndex()
    local index = {}
    for name, v in pairs(PET_VALUES) do
        index[name] = {
            regular = v[1],
            np = v[2],
            r = v[3],
            f = v[4],
            neon = v[5],
            nnp = v[6],
            nr = v[7],
            nf = v[8],
            mega = v[9],
            mnp = v[10],
            mr = v[11],
            mf = v[12],
        }
    end
    return index
end

local VALUE_INDEX = makeValueIndex()

-- The AMVGG page contains the complete pet list in the Next.js payload.
-- This parser intentionally accepts the page format used by the supplied snapshot.
local function extractPetsFromAMVGG(body)
    if type(body) ~= "string" then return nil end

    local marker = '\\"pets\\":['
    local start = body:find(marker, 1, true)
    if not start then
        marker = '"pets":['
        start = body:find(marker, 1, true)
        if not start then return nil end
    end

    local arrayStart = body:find("[", start, true)
    if not arrayStart then return nil end

    local depth = 0
    local endPos
    local i = arrayStart
    while i <= #body do
        local c = body:sub(i, i)
        if c == "[" then
            depth += 1
        elseif c == "]" then
            depth -= 1
            if depth == 0 then
                endPos = i
                break
            end
        end
        i += 1
    end

    if not endPos then return nil end

    local raw = body:sub(arrayStart, endPos)
    raw = raw:gsub('\\"', '"')
    raw = raw:gsub("\\/", "/")

    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if not ok or type(decoded) ~= "table" then
        return nil
    end

    local fresh = {}
    for _, pet in ipairs(decoded) do
        if type(pet) == "table" and type(pet.name) == "string" then
            fresh[normalizeName(pet.name)] = {
                regular = tonumber(pet.regularValue),
                np = tonumber(pet.npRegularValue),
                r = tonumber(pet.rValue),
                f = tonumber(pet.fValue),
                neon = tonumber(pet.neonValue),
                nnp = tonumber(pet.npNeonValue),
                nr = tonumber(pet.nrValue),
                nf = tonumber(pet.nfValue),
                mega = tonumber(pet.megaValue),
                mnp = tonumber(pet.npMegaValue),
                mr = tonumber(pet.mrValue),
                mf = tonumber(pet.mfValue),
            }
        end
    end

    if next(fresh) then
        return fresh
    end
end

local function doRequest(url)
    local funcs = {
        function()
            if syn and syn.request then
                return syn.request({Url = url, Method = "GET", Headers = {["User-Agent"] = "Mozilla/5.0"}})
            end
        end,
        function()
            if http and http.request then
                return http.request({Url = url, Method = "GET", Headers = {["User-Agent"] = "Mozilla/5.0"}})
            end
        end,
        function()
            if request then
                return request({Url = url, Method = "GET", Headers = {["User-Agent"] = "Mozilla/5.0"}})
            end
        end,
        function()
            if http_request then
                return http_request({Url = url, Method = "GET", Headers = {["User-Agent"] = "Mozilla/5.0"}})
            end
        end,
        function()
            return {StatusCode = 200, Body = game:HttpGet(url)}
        end,
    }

    for _, fn in ipairs(funcs) do
        local ok, result = pcall(fn)
        if ok and type(result) == "table" then
            local body = result.Body or result.body
            if type(body) == "string" and #body > 1000 then
                return body
            end
        end
    end
end

local lastRefresh = 0
local function refreshValues()
    if os.clock() - lastRefresh < REFRESH_SECONDS then
        return
    end
    lastRefresh = os.clock()

    task.spawn(function()
        local body = doRequest(AMVGG_URL)
        if not body then return end

        local fresh = extractPetsFromAMVGG(body)
        if fresh and next(fresh) then
            VALUE_INDEX = fresh
        end
    end)
end

local function hasVisibleGuiObject(obj)
    if not obj then return false end
    local ok, isGui = pcall(function() return obj:IsA("GuiObject") end)
    if not ok or not isGui then return false end

    local okVisible, visible = pcall(function() return obj.Visible end)
    if not okVisible or not visible then return false end

    local cur = obj.Parent
    while cur do
        local okGui, isGuiParent = pcall(function() return cur:IsA("GuiObject") end)
        if okGui and isGuiParent then
            local okV, v = pcall(function() return cur.Visible end)
            if okV and v == false then return false end
        end

        local okScreen, isScreen = pcall(function() return cur:IsA("ScreenGui") end)
        if okScreen and isScreen then
            local okE, enabled = pcall(function() return cur.Enabled end)
            if okE and enabled == false then return false end
            break
        end
        cur = cur.Parent
    end
    return true
end

local function getTradeAppGui()
    local containers = {}
    local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pg then table.insert(containers, pg) end
    table.insert(containers, CoreGui)

    for _, container in ipairs(containers) do
        local trade = container:FindFirstChild("TradeApp", true)
        if trade then
            local frame = trade:FindFirstChild("Frame", true)
            local negotiation = frame and frame:FindFirstChild("NegotiationFrame", true)
            local confirmation = frame and frame:FindFirstChild("ConfirmationFrame", true)

            local myOffer = negotiation and negotiation:FindFirstChild("MyOffer", true)
            local partnerOffer = negotiation and negotiation:FindFirstChild("PartnerOffer", true)
            local accept = negotiation and negotiation:FindFirstChild("Accept", true)
            local decline = negotiation and negotiation:FindFirstChild("Decline", true)

            local active =
                hasVisibleGuiObject(myOffer)
                or hasVisibleGuiObject(partnerOffer)
                or hasVisibleGuiObject(accept)
                or hasVisibleGuiObject(decline)

            if active then
                return trade, frame or negotiation, negotiation, confirmation
            end

            if hasVisibleGuiObject(confirmation) then
                return trade, frame or confirmation, negotiation, confirmation
            end
        end
    end

    -- Last-resort: find the visible offer panels anywhere and walk upward.
    for _, container in ipairs(containers) do
        for _, obj in ipairs(container:GetDescendants()) do
            if (obj.Name == "MyOffer" or obj.Name == "PartnerOffer") and hasVisibleGuiObject(obj) then
                local cur = obj
                local negotiation, frame, trade
                while cur do
                    if cur.Name == "NegotiationFrame" then
                        negotiation = cur
                    elseif cur.Name == "Frame" and not frame then
                        frame = cur
                    elseif cur.Name == "TradeApp" then
                        trade = cur
                        break
                    end
                    cur = cur.Parent
                end
                if negotiation then
                    return trade or negotiation, frame or negotiation, negotiation, nil
                end
            end
        end
    end

    return nil
end


-- Adopt Me exposes the live TradeApp through Fsys -> UIManager.apps.TradeApp.
-- The offer functions return {items = {...}, confirmed = ...}; older versions of
-- this overlay incorrectly iterated the wrapper itself, which produced 0 values.
local Fsys
local KindDB
local TradeApp

local function getFsys()
    if type(Fsys) == "table" then return Fsys end

    local fsysModule = ReplicatedStorage:FindFirstChild("Fsys")
    if fsysModule then
        local ok, result = pcall(require, fsysModule)
        if ok and type(result) == "table" then
            Fsys = result
            return Fsys
        end
    end

    local envs = {
        getgenv and getgenv() or nil,
        getrenv and getrenv() or nil,
        _G,
    }
    for _, env in ipairs(envs) do
        if type(env) == "table" and type(rawget(env, "Fsys")) == "table" then
            Fsys = rawget(env, "Fsys")
            return Fsys
        end
    end
end

local function getTradeModule()
    if type(TradeApp) == "table" then return TradeApp end

    local fsys = getFsys()
    if fsys and type(fsys.load) == "function" then
        local okUI, uiManager = pcall(fsys.load, "UIManager")
        if okUI and type(uiManager) == "table" then
            local apps = uiManager.apps or uiManager.Apps
            local trade = apps and (apps.TradeApp or apps.tradeApp)
            if type(trade) == "table" then
                TradeApp = trade
                pcall(function() KindDB = fsys.load("KindDB") end)
                return TradeApp
            end
        end

        local okTrade, trade = pcall(fsys.load, "TradeApp")
        if okTrade and type(trade) == "table" then
            TradeApp = trade
            pcall(function() KindDB = fsys.load("KindDB") end)
            return TradeApp
        end
    end

    return nil
end

local function callTradeMethod(tradeModule, names)
    if type(tradeModule) ~= "table" then return nil end
    for _, name in ipairs(names) do
        local fn = tradeModule[name]
        if type(fn) == "function" then
            local ok, result = pcall(fn, tradeModule)
            if ok and type(result) == "table" then
                return result
            end
            local ok2, result2 = pcall(fn)
            if ok2 and type(result2) == "table" then
                return result2
            end
        end
    end
end

local function recursiveFind(tbl, wanted, seen)
    if type(tbl) ~= "table" then return nil end
    seen = seen or {}
    if seen[tbl] then return nil end
    seen[tbl] = true

    for _, key in ipairs(wanted) do
        local v = rawget(tbl, key)
        if v ~= nil then return v end
    end

    for _, v in pairs(tbl) do
        if type(v) == "table" then
            local found = recursiveFind(v, wanted, seen)
            if found ~= nil then return found end
        end
    end
end

local function readBool(v)
    if v == true or v == false then return v end
    if type(v) == "number" then return v ~= 0 end
    return false
end

local function extractItemData(item)
    if type(item) ~= "table" then return nil end

    local data = item.item_data or item.itemData or item.data or item.Data
    if type(data) ~= "table" then
        data = item
    end

    local props = data.properties or item.properties or data.Properties or item.Properties or {}
    if type(props) ~= "table" then props = {} end

    -- Real Adopt Me TradeApp offer entries are normally:
    -- { id = <KindDB id>, properties = {flyable=true, rideable=true, ...} }
    -- They do NOT contain a textual `kind`, so resolve the id through KindDB.
    local kind = data.kind or data.Kind or item.kind or item.Kind
    if type(kind) ~= "string" then
        kind = recursiveFind(data, {"kind", "Kind"})
    end

    if type(kind) ~= "string" then
        local id = data.id or data.Id or item.id or item.Id
        if id ~= nil then
            local db = KindDB
            if not db then
                local fsys = getFsys()
                if fsys and type(fsys.load) == "function" then
                    pcall(function() db = fsys.load("KindDB"); KindDB = db end)
                end
            end
            if type(db) == "table" then
                local entry = db[id] or db[tostring(id)]
                if type(entry) == "table" then
                    kind = entry.name or entry.Name or entry.kind or entry.Kind
                end
            end
        end
    end

    if type(kind) ~= "string" then return nil end

    return {
        kind = kind,
        fly = readBool(props.flyable or props.fly or props.Flyable or props.Fly)
            or readBool(data.flyable or data.fly),
        ride = readBool(props.rideable or props.ride or props.Rideable or props.Ride)
            or readBool(data.rideable or data.ride),
        neon = readBool(props.neon or props.Neon) or readBool(data.neon),
        mega = readBool(props.mega_neon or props.mega or props.MegaNeon)
            or readBool(data.mega_neon or data.mega),
        n = readBool(props.n or props.N) or readBool(data.n),
        m = readBool(props.m or props.M) or readBool(data.m),
    }
end

local function collectItems(result)
    local out = {}

    if type(result) ~= "table" then
        return out
    end

    -- IMPORTANT: TradeApp:_get_my_offer() / :_get_partner_offer() return
    -- an offer wrapper. The actual entries are in offer.items.
    local list = result.items or result.Items
    if type(list) == "table" then
        for _, item in pairs(list) do
            local parsed = extractItemData(item)
            if parsed then
                table.insert(out, parsed)
            end
        end
        return out
    end

    -- Also accept a raw array/table of item records.
    for _, item in pairs(result) do
        if type(item) == "table" then
            local parsed = extractItemData(item)
            if parsed then
                table.insert(out, parsed)
            end
        end
    end

    return out
end

local function getOfferItems(side)
    local tradeModule = getTradeModule()
    local names

    if side == "my" then
        names = {"GetItemsFromMyOffer", "_get_my_offer", "GetItemsFromOffer"}
    else
        names = {"GetItemsFromPartnerOffer", "_get_partner_offer", "GetItemsFromOffer"}
    end

    local result = callTradeMethod(tradeModule, names)
    return collectItems(result)
end

-- GUI fallback: read the item's kind from attributes/Value objects if the
-- internal TradeApp method is not exposed by the current executor.
local function collectGuiItems(container)
    local out = {}
    if not container then return out end

    for _, slot in ipairs(container:GetChildren()) do
        if slot:IsA("GuiButton") or slot:IsA("ImageButton") or slot:IsA("Frame") then
            local kind = slot:GetAttribute("kind") or slot:GetAttribute("Kind")
            local props = slot:GetAttribute("properties") or slot:GetAttribute("Properties")

            if type(kind) == "string" then
                local p = {}
                if type(props) == "string" then
                    local ok, decoded = pcall(function() return HttpService:JSONDecode(props) end)
                    if ok and type(decoded) == "table" then p = decoded end
                elseif type(props) == "table" then
                    p = props
                end

                table.insert(out, {
                    kind = kind,
                    fly = readBool(p.flyable or p.fly),
                    ride = readBool(p.rideable or p.ride),
                    neon = readBool(p.neon),
                    mega = readBool(p.mega_neon or p.mega),
                })
            end
        end
    end
    return out
end

local function getSideItems(side, negotiation)
    local items = getOfferItems(side)
    if #items > 0 then return items end

    if negotiation then
        local body = negotiation:FindFirstChild("Body")
        local offer = body and body:FindFirstChild(side == "my" and "MyOffer" or "PartnerOffer")
        local slots = offer and offer:FindFirstChild("Slots")
        return collectGuiItems(slots)
    end

    return {}
end

local ACTIVE_MODE = "baseless"

-- Ridepot is a separate currency. It is NOT calculated by multiplying AMVGG.
-- The original AMVGG constants point to this source.
local RIDEPOT_URL = "https://pastebin.com/raw/v8h9cMxp"
local RIDEPOT_VALUES = {}
local RIDEPOT_LOADED = false

local requestFunction =
    (syn and syn.request) or
    (http and http.request) or
    request or
    (fluxus and fluxus.request)

local function rideKey(s)
    if type(s) ~= "string" then return "" end
    s = normalizeName(s)
    s = s:gsub("^pet%s+", "")
    return s
end

local function addRideValue(name, value)
    local n = tonumber(value)
    if type(name) == "string" and n then
        RIDEPOT_VALUES[rideKey(name)] = n
    end
end

local function parseRidepot(body)
    if type(body) ~= "string" or body == "" then return end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(body)
    end)
    if ok and type(data) == "table" then
        local function walk(t, name)
            for k,v in pairs(t) do
                if type(v) == "number" then
                    addRideValue(name or k, v)
                elseif type(v) == "table" then
                    local n = name
                    if type(v.name) == "string" then n = v.name end
                    if type(k) == "string" and not n then n = k end
                    walk(v, n)
                end
            end
        end
        walk(data, nil)
    end

    -- Also accept simple Lua/JSON-like "Name": number entries.
    for name, value in body:gmatch("[\"']([^\"']+)[\"']%s*[:=]%s*([%d%.]+)") do
        addRideValue(name, value)
    end
end

local function loadRidepot()
    if RIDEPOT_LOADED then return end
    RIDEPOT_LOADED = true
    if not requestFunction then return end
    pcall(function()
        local r = requestFunction({
            Url = RIDEPOT_URL,
            Method = "GET",
            Headers = { ["User-Agent"] = "Mozilla/5.0", ["Accept"] = "*/*" }
        })
        if r and r.Body then parseRidepot(r.Body) end
    end)
end

task.spawn(loadRidepot)

local function baselessValueForItem(item)
    if type(item) ~= "table" then return 0 end
    local key = normalizeName(item.kind)
    local v = VALUE_INDEX[key]
    if not v then
        key = key:gsub("^pet_", ""):gsub("_pet$", "")
        v = VALUE_INDEX[key]
    end
    if not v then return 0 end

    local mega = item.mega or item.m
    local neon = item.neon or item.n
    local fly = item.fly
    local ride = item.ride

    if mega then
        if fly and ride and v.mf then return v.mf end
        if ride and v.mr then return v.mr end
        if fly and v.mf then return v.mf end
        return v.mega or 0
    end
    if neon then
        if fly and ride and v.nf and v.nr then return (v.nf + v.nr) / 2 end
        if ride and v.nr then return v.nr end
        if fly and v.nf then return v.nf end
        return v.neon or 0
    end
    if fly and ride and v.f and v.r then return (v.f + v.r) / 2 end
    if ride and v.r then return v.r end
    if fly and v.f then return v.f end
    return v.regular or 0
end

local function valueForItem(item)
    if ACTIVE_MODE ~= "ridepot" then
        return baselessValueForItem(item)
    end

    loadRidepot()
    local key = rideKey(item and item.kind)
    local mega = item and (item.mega or item.m)
    local neon = item and (item.neon or item.n)

    local candidates = {}
    if mega then
        candidates = {
            key .. " mega", "mega " .. key,
            key .. "|mega", key .. "_mega"
        }
    elseif neon then
        candidates = {
            key .. " neon", "neon " .. key,
            key .. "|neon", key .. "_neon"
        }
    else
        candidates = {key}
    end

    for _, k in ipairs(candidates) do
        local v = RIDEPOT_VALUES[rideKey(k)]
        if v then return v end
    end

    -- Exact calibration requested by the user; no global multiplier is used.
    if mega and key == "bat dragon" then
        return 5736.5
    end

    return 0
end

local function total(items)
    local sum = 0
    for _, item in ipairs(items) do
        sum += valueForItem(item)
    end
    return sum
end

local function formatValue(n)
    if not n or n == 0 then return "0" end
    local s = string.format("%.3f", n)
    s = s:gsub("(%..-)0+$", "%1"):gsub("%.$", "")
    return s
end

