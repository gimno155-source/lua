local function setValueBar(myTotal, partnerTotal)
    local width = valueBar.AbsoluteSize.X
    if width <= 0 then return end

    local maxValue = math.max(myTotal, partnerTotal, 0.0001)
    local difference = math.abs(myTotal - partnerTotal)

    -- 50% is the normal center.
    -- The difference changes the boundary, but it is ALWAYS clamped
    -- between the left and right edges of the existing GUI bar.
    local shift = math.clamp(
        (difference / maxValue) * 0.5,
        0,
        0.5
    )

    if myTotal > partnerTotal then
        -- You overpay:
        -- red side grows from 50% toward the RIGHT,
        -- but never leaves the rounded bar.
        local boundary = 0.5 + shift

        valueFill.Position = UDim2.fromScale(0, 0)
        valueFill.Size = UDim2.fromScale(boundary, 1)
        valueFill.BackgroundColor3 = Color3.fromRGB(225, 55, 55)

        rightFill.Position = UDim2.fromScale(boundary, 0)
        rightFill.Size = UDim2.fromScale(1 - boundary, 1)
        rightFill.BackgroundColor3 = Color3.fromRGB(45, 201, 105)

    elseif partnerTotal > myTotal then
        -- They overpay:
        -- the right/green side moves LEFT,
        -- again staying completely inside the GUI.
        local boundary = 0.5 - shift

        valueFill.Position = UDim2.fromScale(0, 0)
        valueFill.Size = UDim2.fromScale(boundary, 1)
        valueFill.BackgroundColor3 = Color3.fromRGB(31, 177, 89)

        rightFill.Position = UDim2.fromScale(boundary, 0)
        rightFill.Size = UDim2.fromScale(1 - boundary, 1)
        rightFill.BackgroundColor3 = Color3.fromRGB(45, 201, 105)

    else
        -- Equal: one continuous full green bar.
        valueFill.Position = UDim2.fromScale(0, 0)
        valueFill.Size = UDim2.fromScale(0.5, 1)
        valueFill.BackgroundColor3 = Color3.fromRGB(31, 177, 89)

        rightFill.Position = UDim2.fromScale(0.5, 0)
        rightFill.Size = UDim2.fromScale(0.5, 1)
        rightFill.BackgroundColor3 = Color3.fromRGB(45, 201, 105)
    end
end

local function update()
    -- Default state on EVERY refresh: the whole AMVGG GUI is hidden.
    gui.Enabled = false

    local trade, frame, negotiation, confirmation = getTradeAppGui()
    if not trade or not frame then
        return
    end

    -- getTradeAppGui() has already verified a visible live trade.
    gui.Enabled = true

    -- EXACT TRADE ATTACHMENT:
    -- Use NegotiationFrame itself, NOT TradeApp.Frame.
    -- This makes the AMVGG panel the same width as the real Trade window
    -- and places its bottom edge directly against the Trade top edge.
    local target = negotiation or confirmation or frame
    if target and target:IsA("GuiObject") then
        local pos = target.AbsolutePosition
        local size = target.AbsoluteSize

        -- EXACT same width as the live Trade window.
        main.Size = UDim2.fromOffset(size.X, HEIGHT)

        -- Center exactly over the Trade window.
        local centeredX = pos.X + (size.X / 2)

        -- Main.AnchorPoint = (0.5, 1), so Position.Y is its BOTTOM edge.
        -- Therefore this touches the top edge of the Trade window exactly.
        local y = pos.Y + MOVE_Y

        main.Position = UDim2.fromOffset(centeredX, y)
    end

    refreshValues()

    local myItems = getSideItems("my", negotiation)
    local partnerItems = getSideItems("partner", negotiation)

    local myTotal = total(myItems)
    local partnerTotal = total(partnerItems)
    local difference = partnerTotal - myTotal
    setValueBar(myTotal, partnerTotal)

    you.Text = formatValue(myTotal)
    them.Text = formatValue(partnerTotal)

    if difference >= 0 then
        delta.Text = "+" .. formatValue(difference)
    else
        delta.Text = formatValue(difference)
    end

    -- AMVGG-style result colors:
    -- green = you receive more
    -- red   = you give more
    -- neutral = equal
    if myTotal > partnerTotal then
        result.Text = "LOSE"
    elseif partnerTotal > myTotal then
        result.Text = "WIN"
    else
        result.Text = "FAIR"
    end
end


task.spawn(function()
    -- Give the game a moment to finish loading before the first request.
    task.wait(1)
    refreshValues()

    while gui.Parent do
        pcall(update)
        task.wait(0.20)
    end
end)

