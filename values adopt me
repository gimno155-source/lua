local function safeRequire(obj)
    local ok, result = pcall(require, obj)
    if ok then return result end
end

local function normalizeName(s)
    if type(s) ~= "string" then return "" end
    s = s:lower()
    s = s:gsub("[%c]", " ")
    s = s:gsub("[_%-]+", " ")
    s = s:gsub("%s+", " ")
    s = s:gsub("^%s+", ""):gsub("%s+$", "")
    return s
end

