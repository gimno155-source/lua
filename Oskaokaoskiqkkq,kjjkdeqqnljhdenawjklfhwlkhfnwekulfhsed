-- ========== دوال التداول ==========
local function getTradeStatus()
    local success, status = pcall(function()
        return GetStatus:InvokeServer()
    end)
    return success and status or "None"
end

local function sendTradeRequest(targetPlayer)
    if not targetPlayer or not targetPlayer.Parent then
        return false
    end
    
    local status = getTradeStatus()
    if status ~= "None" then
        return false
    end
    
    local success = pcall(function()
        return SendRequest:InvokeServer(targetPlayer)
    end)
    
    if success then
        print("[✓] Trade request sent to:", targetPlayer.Name)
        return true
    end
    return false
end

local function sendItemsToTrade(items, maxItems)
    maxItems = maxItems or 4
    local sentCount = 0
    
    for i, item in ipairs(items) do
        if sentCount >= maxItems then break end
        
        for _ = 1, math.min(item.Amount, 1) do
            local success = pcall(function()
                OfferItem:FireServer(item.DataID, "Weapons")
            end)
            if success then
                sentCount = sentCount + 1
                print("[✓] Offered:", item.Name)
            end
            task.wait(0.2)
        end
    end
    
    return sentCount
end

local function acceptTrade()
    if not lastOffer then return false end
    return pcall(function()
        AcceptTrade:FireServer(game.PlaceId * 3, lastOffer)
    end)
end

