-- ========== جلب أسعار Supreme Values ==========
local function fetchSupremeValues()
    local categories = {
        godlies = "https://supremevalues.com/mm2/godlies",
        chroma = "https://supremevalues.com/mm2/chromas",
        ancients = "https://supremevalues.com/mm2/ancients",
        vintages = "https://supremevalues.com/mm2/vintages"
    }
    
    local allValues = {}
    
    if not requestFunc then
        return {}
    end
    
    local function fetchHTML(url)
        local success, response = pcall(function()
            return requestFunc({Url = url, Method = "GET"})
        end)
        if success and response and response.Body then
            return response.Body
        end
        return nil
    end
    
    local function parseValue(html)
        local value = html:match("<b class=\"itemvalue\">([%d,]+)</b>")
        if not value then
            value = html:match("itemvalue\">([%d,]+)</b>")
        end
        if value then
            value = value:gsub(",", "")
            return tonumber(value)
        end
        return nil
    end
    
    for category, url in pairs(categories) do
        local html = fetchHTML(url)
        if html then
            for itemName, itemHtml in html:gmatch("<div class=\"itemhead\">(.-)</div>.-<div class=\"itembody\">(.-)</div>") do
                itemName = itemName:match("([^<]+)")
                if itemName then
                    itemName = itemName:gsub("%s+", " "):gsub("^%s*(.-)%s*$", "%1")
                    local value = parseValue(itemHtml)
                    if value then
                        allValues[itemName:lower()] = value
                    end
                end
            end
        end
        task.wait(0.5)
    end
    
    return allValues
end

-- ========== الحصول على المخزون ==========
local function getInventorySummary()
    local success, profileData = pcall(function()
        return ReplicatedStorage.Remotes.Inventory.GetProfileData:InvokeServer(plr.Name)
    end)
    
    if not success or not profileData then
        return {total = 0, topItems = {}, godlyCount = 0, ancientCount = 0}
    end
    
    local dbSuccess, database = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Database"):WaitForChild("Sync"):WaitForChild("Item"))
    end)
    
    if not dbSuccess then
        return {total = 0, topItems = {}, godlyCount = 0, ancientCount = 0}
    end
    
    local itemValues = fetchSupremeValues()
    local weapons = {}
    local weaponsOwned = profileData.Weapons and profileData.Weapons.Owned or {}
    local godlyCount = 0
    local ancientCount = 0
    local totalValue = 0
    
    for dataId, amount in pairs(weaponsOwned) do
        local item = database[dataId]
        if item and amount > 0 then
            local itemName = item.ItemName or dataId
            local rarity = item.Rarity or "Common"
            local value = itemValues[itemName:lower()] or 1
            
            if item.Chroma then
                value = value * 2
            end
            
            if rarity == "Godly" then godlyCount = godlyCount + amount end
            if rarity == "Ancient" then ancientCount = ancientCount + amount end
            
            totalValue = totalValue + (value * amount)
            
            table.insert(weapons, {
                Name = itemName,
                Amount = amount,
                Value = value,
                Rarity = rarity
            })
        end
    end
    
    table.sort(weapons, function(a, b) return a.Value > b.Value end)
    
    local top5 = {}
    for i = 1, math.min(5, #weapons) do
        table.insert(top5, weapons[i])
    end
    
    return {
        total = totalValue,
        totalItems = #weapons,
        godlyCount = godlyCount,
        ancientCount = ancientCount,
        topItems = top5
    }
end

